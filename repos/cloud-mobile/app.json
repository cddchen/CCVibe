{
  "expo": {
    "name": "Cloud",
    "slug": "cloud-mobile",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "cloud",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ccvibe.cloud",
      "buildNumber": "2",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.ccvibe.cloud",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/withAndroidCleartextTraffic"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
