{
  "name": "@ccvibe/cloud-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings=0",
    "bundle:ios": "expo export --platform ios",
    "bundle:android": "expo export --platform android",
    "build:ios:device": "bash scripts/build-ios-device.sh",
    "build:android:release": "bash scripts/build-android-release.sh",
    "build:mobile:release": "bash scripts/build-mobile-release.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "0.1.10",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "markdown-it": "^14.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^8.57.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
