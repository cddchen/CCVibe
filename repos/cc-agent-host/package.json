{
  "name": "@ccvibe/agent-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ccvibe-agent-host": "./dist/bin/agent-host.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/agent-host.js",
    "start:dev": "npm run build && node dist/bin/agent-host.js",
    "start:prod": "npm run build && node dist/bin/agent-host.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.120.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "^5.12.1",
    "zod": "4.4.3"
  }
}
