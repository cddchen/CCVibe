{
  "name": "@cddchen/cloud",
  "version": "0.6.0",
  "description": "Run a Cloud Agent Host for Claude Code sessions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cloud": "dist/bin/cloud.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/bin/cloud.js start",
    "stop": "node dist/bin/cloud.js stop",
    "status": "node dist/bin/cloud.js status",
    "start:dev": "npm run build && node dist/bin/cloud.js start",
    "start:prod": "npm run build && node dist/bin/cloud.js start --env=production --foreground"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.120.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "^5.12.1",
    "zod": "4.4.3"
  }
}
